# BI Data Compare - Environment Variables
# Copy this file to .env and fill in your values
# For Docker, copy to .env.docker

# SQL Server SA Password (for Docker SQL containers)
# IMPORTANT: Use a strong password that meets SQL Server requirements
SA_PASSWORD=YourStrongP@ssw0rd

# ODBC Driver Configuration (optional)
# If not set, the application will auto-detect available drivers
# Common values:
#   - ODBC Driver 18 for SQL Server (recommended, used in Docker)
#   - ODBC Driver 17 for SQL Server
#   - SQL Server Native Client 11.0
# ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Source Database Connection
SOURCE_SERVER=localhost
SOURCE_DATABASE=master
SOURCE_USERNAME=sa
SOURCE_PASSWORD=YourStrongP@ssw0rd

# Target Database Connection
TARGET_SERVER=localhost
TARGET_DATABASE=master
TARGET_USERNAME=sa
TARGET_PASSWORD=YourStrongP@ssw0rd

# Application Settings (optional)
LOG_LEVEL=INFO

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# JWT Secret Key for API authentication
# IMPORTANT: Set a strong, unique secret key for production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated on each restart (tokens won't persist)
# JWT_SECRET_KEY=your-secure-secret-key-here

# JWT Token Expiration (hours)
# JWT_EXPIRATION_HOURS=24

# CORS Allowed Origins (comma-separated list)
# For production, specify only your trusted domains
# CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502,http://localhost:8503

# Database SSL Certificate Validation
# Set to 'no' in production with proper SSL certificates
# Default is 'yes' which trusts all certificates (for development only)
# DB_TRUST_SERVER_CERTIFICATE=no
